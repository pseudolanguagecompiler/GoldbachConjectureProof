import Mathlib.Data.Complex.Basic
import Mathlib.Data.Real.Sqrt
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum

/-!
# Li–Liu's spectral criteria

This file formalizes the complex-slice algebra in §2.4 of Li–Liu's
A Conditional Proof of the Goldbach Conjecture. The spectral product's
zero-factor correspondence and the operator norm's eigenvalue comparison
enter as hypotheses. The stronger arithmetic norm estimates remain open here.

Checked with Lean 4.19.0 and mathlib v4.19.0. From a matching mathlib
project, run: lake env lean LiLiu.lean
-/

namespace LiLiu

def HypothesisR (X : ℂ → ℂ) : Prop :=
  ∀ q, X q = 0 → q.re = 1 / 2

def HypothesisS (X : ℂ → ℂ) (η : ℝ) : Prop :=
  ∀ q, 1 - η < q.re → X q ≠ 0

theorem R_implies_S {X : ℂ → ℂ} {η : ℝ}
    (hη : η ≤ 1 / 2) (hR : HypothesisR X) : HypothesisS X η := by
  intro q hq hz
  have hre := hR q hz
  linarith

private theorem root_parts {q : ℂ} {c : ℝ}
    (h : q * (1 - q) = (c : ℂ)) :
    q.re * (1 - q.re) + q.im ^ 2 = c ∧
      (1 - 2 * q.re) * q.im = 0 := by
  have hr := congrArg Complex.re h
  have hi := congrArg Complex.im h
  simp only [Complex.mul_re, Complex.mul_im, Complex.sub_re, Complex.sub_im,
    Complex.one_re, Complex.one_im, Complex.ofReal_re, Complex.ofReal_im] at hr hi
  constructor <;> nlinarith

private theorem real_root {x c : ℝ} (hx : x * (1 - x) = c) :
    (x : ℂ) * (1 - (x : ℂ)) = (c : ℂ) := by
  exact_mod_cast hx

private theorem right_root {c : ℝ} (hc : c < 1 / 4) :
    ∃ x : ℝ, 1 / 2 < x ∧ x * (1 - x) = c := by
  have hd : 0 < 1 - 4 * c := by linarith
  have hs := Real.sq_sqrt hd.le
  have hp := Real.sqrt_pos.2 hd
  refine ⟨(1 + Real.sqrt (1 - 4 * c)) / 2, by linarith, ?_⟩
  nlinarith

theorem factor_R_iff (c : ℝ) :
    (∀ q : ℂ, q * (1 - q) = (c : ℂ) → q.re = 1 / 2) ↔ 1 / 4 ≤ c := by
  constructor
  · intro h
    by_contra! hc
    obtain ⟨x, hx, hroot⟩ := right_root hc
    have he := h (x : ℂ) (real_root hroot)
    rw [Complex.ofReal_re] at he
    linarith
  · intro hc q hq
    obtain ⟨hr, hi⟩ := root_parts hq
    rcases mul_eq_zero.mp hi with h | h
    · linarith
    · rw [h] at hr
      nlinarith [sq_nonneg (q.re - 1 / 2)]

theorem factor_S_iff (c : ℝ) {η : ℝ} (hη : η < 1 / 2) :
    (∀ q : ℂ, 1 - η < q.re → q * (1 - q) ≠ (c : ℂ)) ↔
      η * (1 - η) ≤ c := by
  constructor
  · intro h
    by_contra! hc
    have hc' : c < 1 / 4 := by nlinarith [sq_nonneg (η - 1 / 2)]
    obtain ⟨x, hx, hroot⟩ := right_root hc'
    have hx' : 1 - η < x := by
      by_contra! hle
      have hp := mul_nonneg (sub_nonneg.mpr hle) (show 0 ≤ x - η by linarith)
      nlinarith
    exact h (x : ℂ) (by simpa only [Complex.ofReal_re] using hx') (real_root hroot)
  · intro hc q hq hroot
    obtain ⟨hr, hi⟩ := root_parts hroot
    rcases mul_eq_zero.mp hi with h | h
    · linarith
    · rw [h] at hr
      have hp := mul_pos (show 0 < q.re - (1 - η) by linarith)
        (show 0 < q.re - η by linarith)
      nlinarith

section Spectrum

variable {ι : Type*} {X : ℂ → ℂ} {c : ι → ℝ}

theorem spectral_R_iff
    (hZeros : ∀ q : ℂ, X q = 0 ↔ ∃ j, q * (1 - q) = (c j : ℂ)) :
    HypothesisR X ↔ ∀ j, 1 / 4 ≤ c j := by
  constructor
  · intro h j
    exact (factor_R_iff (c j)).mp fun q hq => h q ((hZeros q).2 ⟨j, hq⟩)
  · intro h q hq
    obtain ⟨j, hj⟩ := (hZeros q).1 hq
    exact (factor_R_iff (c j)).mpr (h j) q hj

theorem spectral_S_iff {η : ℝ} (hη : η < 1 / 2)
    (hZeros : ∀ q : ℂ, X q = 0 ↔ ∃ j, q * (1 - q) = (c j : ℂ)) :
    HypothesisS X η ↔ ∀ j, η * (1 - η) ≤ c j := by
  constructor
  · intro h j
    exact (factor_S_iff (c j) hη).mp fun q hq hz =>
      h q hq ((hZeros q).2 ⟨j, hz⟩)
  · intro h q hq hz
    obtain ⟨j, hj⟩ := (hZeros q).1 hz
    exact (factor_S_iff (c j) hη).mpr (h j) q hq hj

end Spectrum

section Norm

variable {ι : Type*} {X : ℂ → ℂ} {μ : ι → ℝ} {δ M η : ℝ}

/-- Squared form of the sharp norm criterion for a spectral zero-free width. -/
theorem S_iff_norm_sq_le (hη₀ : 0 < η) (hη₁ : η < 1 / 2)
    (hμ : ∀ j, μ j ≠ 0)
    (hZeros : ∀ q : ℂ, X q = 0 ↔
      ∃ j, q * (1 - q) = ((δ ^ 2 / (4 * μ j ^ 2) : ℝ) : ℂ))
    (hNorm : ∀ B : ℝ, 0 ≤ B → (M ^ 2 ≤ B ↔ ∀ j, μ j ^ 2 ≤ B)) :
    HypothesisS X η ↔ 4 * η * (1 - η) * M ^ 2 ≤ δ ^ 2 := by
  have ha : 0 < 4 * η * (1 - η) :=
    mul_pos (mul_pos (by norm_num) hη₀) (by linarith)
  rw [spectral_S_iff hη₁ hZeros, mul_comm (4 * η * (1 - η)),
    ← le_div_iff₀ ha, hNorm _ (div_nonneg (sq_nonneg δ) ha.le)]
  apply forall_congr'
  intro j
  have hp : 0 < 4 * μ j ^ 2 := mul_pos (by norm_num) (sq_pos_of_ne_zero (hμ j))
  rw [le_div_iff₀ hp, le_div_iff₀ ha]
  constructor <;> intro h <;> nlinarith only [h]

/-- Squared form of the norm criterion for Hypothesis R. -/
theorem R_iff_norm_sq_le (hμ : ∀ j, μ j ≠ 0)
    (hZeros : ∀ q : ℂ, X q = 0 ↔
      ∃ j, q * (1 - q) = ((δ ^ 2 / (4 * μ j ^ 2) : ℝ) : ℂ))
    (hNorm : ∀ B : ℝ, 0 ≤ B → (M ^ 2 ≤ B ↔ ∀ j, μ j ^ 2 ≤ B)) :
    HypothesisR X ↔ M ^ 2 ≤ δ ^ 2 := by
  rw [spectral_R_iff hZeros, hNorm _ (sq_nonneg δ)]
  apply forall_congr'
  intro j
  have hp : 0 < 4 * μ j ^ 2 := mul_pos (by norm_num) (sq_pos_of_ne_zero (hμ j))
  rw [le_div_iff₀ hp]
  constructor <;> intro h <;> linarith only [h]

/-- A norm bound yields a zero-free width by a direct inequality.
For Li–Liu's ERH estimate one supplies B = C (log N)^2. -/
theorem zero_free_of_norm_bound {B : ℝ} (hη₀ : 0 < η) (hη₁ : η < 1 / 2)
    (hμ : ∀ j, μ j ≠ 0)
    (hZeros : ∀ q : ℂ, X q = 0 ↔
      ∃ j, q * (1 - q) = ((δ ^ 2 / (4 * μ j ^ 2) : ℝ) : ℂ))
    (hNorm : ∀ b : ℝ, 0 ≤ b → (M ^ 2 ≤ b ↔ ∀ j, μ j ^ 2 ≤ b))
    (hBound : M ^ 2 ≤ B ^ 2) (hWidth : 4 * η * B ^ 2 ≤ δ ^ 2) :
    HypothesisS X η := by
  apply (S_iff_norm_sq_le hη₀ hη₁ hμ hZeros hNorm).2
  have ha : 0 ≤ 4 * η * (1 - η) :=
    mul_nonneg (mul_nonneg (by norm_num) hη₀.le) (by linarith)
  have hscale : 0 ≤ 4 * η * B ^ 2 :=
    mul_nonneg (mul_nonneg (by norm_num) hη₀.le) (sq_nonneg B)
  calc
    4 * η * (1 - η) * M ^ 2 ≤ 4 * η * (1 - η) * B ^ 2 :=
      mul_le_mul_of_nonneg_left hBound ha
    _ ≤ 4 * η * B ^ 2 := by
      have h := mul_le_mul_of_nonneg_right (show 1 - η ≤ 1 by linarith) hscale
      nlinarith only [h]
    _ ≤ δ ^ 2 := hWidth

end Norm

end LiLiu
