import Mathlib.Data.Complex.Basic
import Mathlib.Data.Real.Sqrt
import Mathlib.Tactic.Linarith
import Mathlib.Tactic.NormNum

import Mathlib.MeasureTheory.Integral.Prod

/-! Conditional Hypothesis R. Lean and mathlib v4.19.0.
Run: lake env lean ConditionalR.lean

The boundary realization, its eigenfunction energy identity and the spectral-product
zero classification are analytic inputs. The arithmetic input is row bound (B).
The integral estimate below is proved on a measure space, including infinite spaces. -/

namespace ConditionalR

def HypothesisR (X : ℂ → ℂ) : Prop :=
  ∀ q, X q = 0 → q.re = 1 / 2

private theorem root_parts {q : ℂ} {c : ℝ}
    (h : q * (1 - q) = (c : ℂ)) :
    q.re * (1 - q.re) + q.im ^ 2 = c ∧
      (1 - 2 * q.re) * q.im = 0 := by
  have hr := congrArg Complex.re h
  have hi := congrArg Complex.im h
  simp only [Complex.mul_re, Complex.mul_im, Complex.sub_re, Complex.sub_im,
    Complex.one_re, Complex.one_im, Complex.ofReal_re, Complex.ofReal_im] at hr hi
  constructor <;> nlinarith

private theorem real_root {x c : ℝ} (hx : x * (1 - x) = c) :
    (x : ℂ) * (1 - (x : ℂ)) = (c : ℂ) := by
  exact_mod_cast hx

private theorem right_root {c : ℝ} (hc : c < 1 / 4) :
    ∃ x : ℝ, 1 / 2 < x ∧ x * (1 - x) = c := by
  have hd : 0 < 1 - 4 * c := by linarith
  have hs := Real.sq_sqrt hd.le
  have hp := Real.sqrt_pos.2 hd
  refine ⟨(1 + Real.sqrt (1 - 4 * c)) / 2, by linarith, ?_⟩
  nlinarith

theorem factor_R_iff (c : ℝ) :
    (∀ q : ℂ, q * (1 - q) = (c : ℂ) → q.re = 1 / 2) ↔ 1 / 4 ≤ c := by
  constructor
  · intro h
    by_contra! hc
    obtain ⟨x, hx, hroot⟩ := right_root hc
    have he := h (x : ℂ) (real_root hroot)
    rw [Complex.ofReal_re] at he
    linarith
  · intro hc q hq
    obtain ⟨hr, hi⟩ := root_parts hq
    rcases mul_eq_zero.mp hi with h | h
    · linarith
    · rw [h] at hr
      nlinarith [sq_nonneg (q.re - 1 / 2)]

open MeasureTheory
open scoped ComplexConjugate

variable {S : Type*} [MeasurableSpace S] (ν : Measure S) [SFinite ν]

/-- Row correlations of the arithmetic residual in the weighted boundary measure. -/
noncomputable def corr (E : S → S → ℂ) (x y : S) : ℂ :=
  ∫ u, E x u * conj (E y u) ∂ν

def BoundB (E : S → S → ℂ) (δ : ℝ) : Prop :=
  ∀ᵐ x ∂ν, (∫ y, ‖corr ν E x y‖ ∂ν) ≤ δ ^ 2

/-- A quadratic-form estimate for a normalized eigenfunction.
The energy identity is for the squared operator, whose kernel is C. -/
theorem kernel_energy (C : S → S → ℂ) (f : S → ℂ) (μ δ : ℝ)
    (symm : ∀ x y, ‖C x y‖ = ‖C y x‖)
    (row : ∀ᵐ x ∂ν, (∫ y, ‖C x y‖ ∂ν) ≤ δ ^ 2)
    (fint : Integrable (fun x => ‖f x‖ ^ 2) ν)
    (unit : (∫ x, ‖f x‖ ^ 2 ∂ν) = 1)
    (wint : Integrable (fun p : S × S => ‖f p.1‖ ^ 2 * ‖C p.1 p.2‖) (ν.prod ν))
    (eint : Integrable (fun p : S × S => (conj (f p.1) * C p.1 p.2 * f p.2).re)
      (ν.prod ν))
    (energy : μ ^ 2 = ∫ p : S × S, (conj (f p.1) * C p.1 p.2 * f p.2).re ∂ν.prod ν) :
    μ ^ 2 ≤ δ ^ 2 := by
  let w := fun p : S × S => ‖f p.1‖ ^ 2 * ‖C p.1 p.2‖
  have hw : Integrable w (ν.prod ν) := wint
  have hb : (∫ p, w p ∂ν.prod ν) ≤ δ ^ 2 := by
    rw [integral_prod _ hw]
    calc
      _ ≤ ∫ x, ‖f x‖ ^ 2 * δ ^ 2 ∂ν := by
        apply integral_mono_ae hw.integral_prod_left (fint.mul_const _)
        filter_upwards [row] with x hx
        dsimp [w]
        rw [integral_const_mul]
        exact mul_le_mul_of_nonneg_left hx (sq_nonneg _)
      _ = _ := by rw [integral_mul_const, unit, one_mul]
  have hpoint (p : S × S) :
      2 * (conj (f p.1) * C p.1 p.2 * f p.2).re ≤ w p + w p.swap := by
    have h := Complex.re_le_norm (conj (f p.1) * C p.1 p.2 * f p.2)
    simp only [norm_mul, Complex.norm_conj] at h
    change 2 * _ ≤ ‖f p.1‖ ^ 2 * ‖C p.1 p.2‖ + ‖f p.2‖ ^ 2 * ‖C p.2 p.1‖
    rw [symm p.2 p.1]
    nlinarith only [h, mul_nonneg (sq_nonneg (‖f p.1‖ - ‖f p.2‖)) (norm_nonneg (C p.1 p.2))]
  have hi := integral_mono (eint.const_mul 2) (hw.add hw.swap) hpoint
  change (∫ p : S × S, 2 * _ ∂ν.prod ν) ≤ ∫ p, w p + w p.swap ∂ν.prod ν at hi
  rw [integral_const_mul, ← energy, integral_add hw (show Integrable (fun p => w p.swap) (ν.prod ν) from hw.swap), integral_prod_swap] at hi
  linarith

/-- The hypotheses before B describe the spectral and measure-theoretic
realization of the boundary operator. No eigenvalue bound is an input. -/
theorem hypothesisR_of_B {ι : Type*} (E : S → S → ℂ) (X : ℂ → ℂ)
    (μ : ι → ℝ) (δ : ℝ) (nonzero : ∀ j, μ j ≠ 0)
    (zeros : ∀ q : ℂ, X q = 0 ↔
      ∃ j, q * (1 - q) = ((δ ^ 2 / (4 * μ j ^ 2) : ℝ) : ℂ))
    (eigen : ∀ j, ∃ f : S → ℂ,
      Integrable (fun x => ‖f x‖ ^ 2) ν ∧
      (∫ x, ‖f x‖ ^ 2 ∂ν) = 1 ∧
      Integrable (fun p : S × S => ‖f p.1‖ ^ 2 * ‖corr ν E p.1 p.2‖) (ν.prod ν) ∧
      Integrable (fun p : S × S => (conj (f p.1) * corr ν E p.1 p.2 * f p.2).re) (ν.prod ν) ∧
      μ j ^ 2 = ∫ p : S × S, (conj (f p.1) * corr ν E p.1 p.2 * f p.2).re ∂ν.prod ν)
    (B : BoundB ν E δ) : HypothesisR X := by
  intro q hq
  obtain ⟨j, hj⟩ := (zeros q).1 hq
  obtain ⟨f, hf, hu, hw, he, hi⟩ := eigen j
  have symm (x y : S) : ‖corr ν E x y‖ = ‖corr ν E y x‖ := by
    have hc : conj (corr ν E x y) = corr ν E y x := by
      unfold corr
      rw [← integral_conj]
      apply integral_congr_ae
      filter_upwards [] with u
      simp [mul_comm]
    rw [← hc, Complex.norm_conj]
  have h := kernel_energy ν _ f _ _ symm B hf hu hw he hi
  apply (factor_R_iff _).2 _ q hj
  apply (le_div_iff₀ (mul_pos (by norm_num : (0 : ℝ) < 4)
    (sq_pos_of_ne_zero (nonzero j)))).2
  linarith only [h]

end ConditionalR
